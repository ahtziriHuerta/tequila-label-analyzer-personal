# Copia este archivo como backend/.env (no se sube a git) y llena lo que uses.

# Lectura de fotos con Gemini (Google). Sin clave se usa PaddleOCR y, si falla, Tesseract.
# Ojo: las fotos se envían a Google; con una clave de nivel gratuito Google puede usar esos datos.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MODEL_RESPALDO=gemini-3.5-flash

# Motor principal: gemini | paddle | tesseract (si no se indica: gemini con clave, si no paddle).
# OCR_MOTOR=gemini
